{
  "name": "hopeandtruthministry-site",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite-react-ssg build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "sync-content": "tsx scripts/sync-content.ts",
    "rcl-map": "tsx scripts/rcl-vanderbilt.ts",
    "check:rcl": "tsx scripts/rcl-vanderbilt.ts --check",
    "import-posts": "tsx scripts/import-posts.ts",
    "validate-extract": "tsx scripts/validate-extract.ts",
    "test": "vitest run && sh scripts/py.sh -m pytest -q",
    "test:watch": "vitest",
    "test:py": "sh scripts/py.sh -m pytest -v",
    "lint": "eslint . && sh scripts/py.sh -m ruff check scripts/",
    "lint:fix": "eslint . --fix && sh scripts/py.sh -m ruff check scripts/ --fix",
    "lint:ts": "eslint .",
    "lint:py": "sh scripts/py.sh -m ruff check scripts/",
    "test:coverage": "vitest run --coverage && sh scripts/py.sh -m pytest -q --cov --cov-report=term-missing --cov-report=html",
    "setup:py": "python3 -m venv .venv && sh scripts/py.sh -m pip install -q -r requirements-dev.txt"
  },
  "dependencies": {
    "lucide-react": "^0.460.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.30.4",
    "vite-react-ssg": "^0.9.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^22.10.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^6.0.4",
    "@vitest/coverage-v8": "^4.1.8",
    "@vitest/ui": "^4.1.8",
    "autoprefixer": "^10.4.20",
    "eslint": "^10.4.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.6.0",
    "jsdom": "^29.1.1",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.15",
    "tsx": "^4.22.4",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.61.0",
    "vite": "^8.1.5",
    "vitest": "^4.1.8"
  }
}
