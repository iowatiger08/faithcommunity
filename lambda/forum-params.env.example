# Forum Q&A deploy parameters — copy to forum-params.env and fill in.
#
# forum-params.env is gitignored. It must stay that way: both .env and
# samconfig.toml are tracked in git, so neither is a safe home for these.
#
# Generate the two random values:
#   openssl rand -base64 18    # ForumAdminCode   (24 chars)
#   openssl rand -hex 32       # ForumTokenSecret (64 chars)
#
# ForumMemberCode is announced from the front and printed in the bulletin, so
# it needs to be speakable — but still 10+ characters with mixed case and a
# digit. It only permits SUBMITTING a question, so a leak costs little.
#
# ForumAdminCode reads EVERY submission. Treat it as a password: long, random,
# unrelated to the member code, never spoken aloud or texted, stored in a
# password manager.

ForumMemberCode=
ForumAdminCode=
ForumTokenSecret=
ForumId=windsor-heights-2026-10
ForumClosesAt=2026-10-25T17:00:00Z
