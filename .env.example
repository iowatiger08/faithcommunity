# Build-time API endpoints. These are public URLs, not secrets — but keep real
# values in .env (gitignored) rather than here.
#
# Both come from the SAM stack outputs after ./scripts/deploy-lambda.sh:
#   ContactApiUrl -> VITE_CONTACT_API_URL
#   ForumApiBase  -> VITE_FORUM_API_BASE
VITE_CONTACT_API_URL=
VITE_FORUM_API_BASE=
