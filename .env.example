# Build-time API endpoints. These are public URLs, not secrets — but keep real
# values in .env (gitignored) rather than here.
#
# From the SAM stack outputs after ./scripts/deploy-lambda.sh:
#   ContactApiUrl -> VITE_CONTACT_API_URL
VITE_CONTACT_API_URL=
#
# Comments and reactions (off unless VITE_ENABLE_COMMENTS=true). From outputs:
#   CommentsApiUrl       -> VITE_COMMENTS_API_URL
#   CommentersUserPoolId -> VITE_AUTH_POOL_ID
#   CommentersClientId   -> VITE_AUTH_CLIENT_ID
#   CommentersAuthDomain -> VITE_AUTH_DOMAIN
VITE_ENABLE_COMMENTS=
VITE_COMMENTS_API_URL=
VITE_AUTH_POOL_ID=
VITE_AUTH_CLIENT_ID=
VITE_AUTH_DOMAIN=
